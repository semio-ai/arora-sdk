{
  "id": "arora-robot",
  "version": "v0",
  "title": "Arora robot standard, as the NAOqi HAL maps it",
  "description": "The keys a robot exposes to Arora, independent of its middleware: what the NAOqi HAL maps NAOqi onto. Local to this HAL until an Arora standard exists; a path segment in braces stands for one name ({joint}: a joint's name, {group}: an LED group's name). kind is the device's point of view: an output is sensed and published, an input is commanded.",
  "scope": "device",
  "keys": [
    { "path": "{joint}.position", "kind": "output", "value_type": "f64", "unit": "rad", "description": "measured joint position" },
    { "path": "{joint}.velocity", "kind": "output", "value_type": "f64", "unit": "rad/s", "description": "joint velocity" },
    { "path": "{joint}.stiffness", "kind": "output", "value_type": "f64", "min": 0.0, "max": 1.0, "description": "measured joint stiffness" },
    { "path": "{joint}.temperature", "kind": "output", "value_type": "f64", "unit": "°C", "description": "joint motor temperature" },
    { "path": "{joint}.current", "kind": "output", "value_type": "f64", "unit": "A", "description": "joint motor current" },
    { "path": "{joint}.target_position", "kind": "input", "value_type": "f64", "unit": "rad", "description": "commanded joint position" },
    { "path": "{joint}.target_stiffness", "kind": "input", "value_type": "f64", "min": 0.0, "max": 1.0, "description": "commanded joint stiffness; a joint at zero does not move" },
    { "path": "battery.charge", "kind": "output", "value_type": "f64", "min": 0.0, "max": 1.0, "description": "battery charge" },
    { "path": "battery.current", "kind": "output", "value_type": "f64", "unit": "A", "description": "battery current, positive when charging" },
    { "path": "battery.charging", "kind": "output", "value_type": "bool", "description": "whether the battery is charging" },
    { "path": "imu.angle.x", "kind": "output", "value_type": "f64", "unit": "rad", "description": "torso roll" },
    { "path": "imu.angle.y", "kind": "output", "value_type": "f64", "unit": "rad", "description": "torso pitch" },
    { "path": "imu.gyroscope.x", "kind": "output", "value_type": "f64", "unit": "rad/s", "description": "angular velocity about x" },
    { "path": "imu.gyroscope.y", "kind": "output", "value_type": "f64", "unit": "rad/s", "description": "angular velocity about y" },
    { "path": "imu.gyroscope.z", "kind": "output", "value_type": "f64", "unit": "rad/s", "description": "angular velocity about z" },
    { "path": "imu.accelerometer.x", "kind": "output", "value_type": "f64", "unit": "m/s²", "description": "linear acceleration along x" },
    { "path": "imu.accelerometer.y", "kind": "output", "value_type": "f64", "unit": "m/s²", "description": "linear acceleration along y" },
    { "path": "imu.accelerometer.z", "kind": "output", "value_type": "f64", "unit": "m/s²", "description": "linear acceleration along z" },
    { "path": "sonar.left.distance", "kind": "output", "value_type": "f64", "unit": "m", "description": "distance to the nearest obstacle, left sonar" },
    { "path": "sonar.right.distance", "kind": "output", "value_type": "f64", "unit": "m", "description": "distance to the nearest obstacle, right sonar" },
    { "path": "touch.head.front", "kind": "output", "value_type": "bool", "description": "front head touch sensor" },
    { "path": "touch.head.middle", "kind": "output", "value_type": "bool", "description": "middle head touch sensor" },
    { "path": "touch.head.rear", "kind": "output", "value_type": "bool", "description": "rear head touch sensor" },
    { "path": "touch.hand.left.back", "kind": "output", "value_type": "bool", "description": "left hand, back touch sensor" },
    { "path": "touch.hand.left.left", "kind": "output", "value_type": "bool", "description": "left hand, left touch sensor" },
    { "path": "touch.hand.left.right", "kind": "output", "value_type": "bool", "description": "left hand, right touch sensor" },
    { "path": "touch.hand.right.back", "kind": "output", "value_type": "bool", "description": "right hand, back touch sensor" },
    { "path": "touch.hand.right.left", "kind": "output", "value_type": "bool", "description": "right hand, left touch sensor" },
    { "path": "touch.hand.right.right", "kind": "output", "value_type": "bool", "description": "right hand, right touch sensor" },
    { "path": "bumper.left", "kind": "output", "value_type": "bool", "description": "left foot bumper" },
    { "path": "bumper.right", "kind": "output", "value_type": "bool", "description": "right foot bumper" },
    { "path": "chest_button", "kind": "output", "value_type": "bool", "description": "chest button" },
    { "path": "led.{group}.color", "kind": "input", "value_type": "u32", "description": "LED group color, 0xRRGGBB" },
    { "path": "led.{group}.intensity", "kind": "input", "value_type": "f64", "min": 0.0, "max": 1.0, "description": "LED group intensity" },
    { "path": "velocity.x", "kind": "input", "value_type": "f64", "min": -1.0, "max": 1.0, "description": "forward base velocity, normalized" },
    { "path": "velocity.y", "kind": "input", "value_type": "f64", "min": -1.0, "max": 1.0, "description": "lateral base velocity, normalized" },
    { "path": "rotation.z", "kind": "input", "value_type": "f64", "min": -1.0, "max": 1.0, "description": "base rotation velocity, normalized" }
  ]
}
